include "common/config.kdl"

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    position x=-1920 y=-60
}

output "DP-1" {
    mode "1920x1080@74.973"
    scale 1
    position x=0 y=0
}

workspace "dsc" {
    open-on-output "HDMI-A-1"
}
workspace "brow" {
    open-on-output "HDMI-A-1"
}
workspace "obs" {
    open-on-output "HDMI-A-1"
}

workspace "term" {
    open-on-output "DP-1"
}
workspace "stm" {
    open-on-output "DP-1"
}
workspace "other" {
    open-on-output "DP-1"
}