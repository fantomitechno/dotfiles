{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "niri/workspaces",
    "niri/window",
    "mpris",
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "backlight",
    "pulseaudio",
    "disk",
    "network",
    "tray",
    "custom/notification",
    "memory",
    "cpu",
    "battery",
    "custom/exit"
  ],
  "niri/workspaces": {
    "format": "{value}",
    "current-only": true,
    "hide-empty": true
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{percent}% {icon}",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"]
  },

  "clock": {
    "format": "{:%a %m/%d/%y 󰃭 | %I:%M:%S %p}  ",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode"          : "year",
      "mode-mon-col"  : 3,
      "on-scroll"     : 1,
      "format": {
        "months":     "<span color='#ffead3'><b>{}</b></span>",
        "days":       "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
        "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
      },
    "actions":  {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "niri/window": {
	  "format": "{title} - {app_id}",
    "separate-outputs": false,
    "rewrite": {
      "(?!.*(brave-browser|codium|vesktop|kitty)).*[Oo]pen.*": " opn",
      "(.*) - Twitch - Brave - brave-browser": " $1",
      "(.*) - YouTube - Brave - brave-browser": " $1",
      "(?!.* - (Twitch|YouTube) - Brave)(.*) - Brave - brave-browser": " $2",
      "(.*) - (.*) - VSCodium - codium": " $2/$1",
      "(.*) - VSCodium - codium": " $1",
      "VSCodium - codium": " Empty",
      "[• ]*Discord - vesktop": "",
      "[• ]*Discord . ([^@#].*) - vesktop": " $1",
      "[• ]*Discord . @(.*) - vesktop": " DM/$1",
      "[• ]*Discord . #(.*) . (.*) - vesktop": " $2/$1",
      "Steam - steam": "󰓓 stm",
      "(?!Steam)(.*) - steam": "󰓓 $1",
      "Lumafly - Lumafly": "󰠭 lmfl",
      "(.*) - hollow_knight.x86_64": "󰠭󰷟 hk",
      "(.*) - Hollow Knight Silksong": "󰠭󰎑 hk",
      "Bluetooth Devices - .blueman-manager-wrapped": "󰂯 blth",
      "Volume Control - org.pulseaudio.pavucontrol": " vlm",
      "(.*) - kitty": " [$1]",
      "Signal - signal": "󰭹 sign",
      "(.*) - org.gnome.Nautilus": " $1",
      "(.*) - org.gnome.FileRoller": " $1",
      "[Mm]inecraft (.*) - [Mm]inecraft (.*)": "󰍳 $1",
      "(.*) - org.prismlauncher.PrismLauncher": "󰍳 Prism",
      "Olympus - love": " olmps",
      "Lönn - (.*) - love": " $1",
      "Celeste - celeste": " clst",
      "Network Connections - nm-connection-editor": "󱫋 ntwk",
      "(.*) . Microsoft Teams - teams-for-linux": "󰊻 $1",
      "(.*) — Mozilla Firefox - firefox": " $1",
      "(.*) - VLC Media Player - vlc": "󰕼 $1",
      "VLC Media Player - vlc": "󰕼 vlc",
      "Starting Everest... - EverestSplash-linux": " evrst boot",
      "Picture in picture - " : "󰹗 pip",
      "The Wireshark Network Analyzer - org.wireshark.Wireshark": "󱙳 wrsk",
      "(?!The Wireshark Network Analyzer)(.*) - org.wireshark.Wireshark": "󱙳 $1",
      "OBS (.*) - Profile: (.*) - Scenes: (.*) - com.obsproject.Studio": "󰑋 $2/$3",
      "(.*) / (.*) — Kdenlive - org.kde.kdenlive": "󱄣 $1",
      "NineSols - steam_app(.*)": "󰄛 nnsls"
    }
  },

  "memory": {
    "interval": 5,
    "format": " {}%",
    "format-alt": " {used:0.1f}G/{total:0.1f}G ",
    "tooltip": true
  },

  "cpu": {
    "interval": 5,
    "format": " {usage:2}%",
    "tooltip": true,
    "on-click": "kitty -e btop"
  },

  "disk": {
    "format": " {free}",
    "tooltip": true
  },

  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format-ethernet": " {bandwidthDownBits}",
    "format-wifi": " {bandwidthDownBits}",
    "format-disconnected": "󰤮",
    "tooltip": false
  },

  "tray": {
    "icon-size": 12,
    "spacing": 12
  },

  "pulseaudio": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },

  "custom/exit": {
    "tooltip": false,
    "format": "⏻",
    "on-click": "wlogout"
  },

  "custom/startmenu": {
    "tooltip": false,
    "format": "",
    "on-click": "wofi --show drun"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󱘖 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "on-click": "",
    "tooltip": false
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "interval": 2,
    "ignored-players": [ "chromium" ],
    "max-length": 30
  }
}