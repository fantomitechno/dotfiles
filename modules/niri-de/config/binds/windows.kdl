binds {
    // Code
    Mod+T hotkey-overlay-title="Open a Terminal " { spawn "kitty"; }
    Mod+C hotkey-overlay-title="Open a Text Editor " { spawn "codium"; }
    Mod+I hotkey-overlay-title="Open a Text Editor " { spawn "idea-oss"; }

    // Utility
    Mod+E hotkey-overlay-title="Open a FileManager " { spawn "nautilus"; }
    Mod+B hotkey-overlay-title="Open a Browser " { spawn "brave"; }
    Mod+Return hotkey-overlay-title="Open Calculator " { spawn "gnome-calculator"; }

    // Communication
    Mod+D hotkey-overlay-title="Open a Browser " { spawn-sh "vesktop --enable-blink-features=MiddleClickAutoscroll"; }

    // Music
    Mod+M hotkey-overlay-title="Open Tidal " { spawn "tidal-hifi"; }

    // Games
    Mod+S hotkey-overlay-title="Open Steam " { spawn "steam"; }
}