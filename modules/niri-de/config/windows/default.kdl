include "browsers.kdl"
include "code.kdl"
include "communication.kdl"
include "editing.kdl"
include "games.kdl"
include "utilities.kdl"

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Indicate screencasted windows with red colors.
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2d70"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

window-rule {
    match title="Picture in picture"
    open-floating true
    open-focused false
    default-floating-position x=100 y=100 relative-to="bottom-right"
    tiled-state true
}