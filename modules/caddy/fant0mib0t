{
  email simon@renoux.dev
}

(logging) {
    log {
        output file /var/log/{args[0]}.log
        format console
        # level error
    }
}

@local_net client_ip 172.16.0.0/12
@server_net client_ip 172.16.20.0/24
@admin_net client_ip 172.16.10.0/24
@guest_net client_ip 172.16.100.0/24

fant0mib0t.renoux.dev {
  respond "Welcome!"
}

# Communication
matrix.fantomitechno.dev {
  import logging matrix
  reverse_proxy 127.0.0.1:2000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

pds.fantomitechno.dev {
  import logging pds
  reverse_proxy 127.0.0.1:2010 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}

# Storage
knot.fantomitechno.dev {
